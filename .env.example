GVM_TRANSPORT=plain
GVM_ALLOW_PLAIN_TCP=true
GVM_HOST=10.208.232.43
GVM_PORT=41000
GVM_USERNAME=your-user
GVM_PASSWORD='your-password'
GVM_TIMEOUT=120
# Limite total por solicitud/pagina, ademas del timeout de inactividad.
GVM_REQUEST_TIMEOUT=600
GVM_LEAN_REPORT=true
GVM_REPORT_PAGE_SIZE=250
GVM_MAX_PAGES=200
# Vacío: todas las tareas visibles para este usuario.
GVM_TASK_IDS=
OPENVAS_POLL_SECONDS=600
OPENVAS_REPORT_MAX_KB=30720
# Presupuesto de trafico por listado/reporte paginado; incluye metadata repetida.
OPENVAS_PAGINATION_MAX_KB=65536
OPENVAS_ARTIFACTS_DIR=runtime/openvas/artifacts
ALERT_SEVERITIES=critical,high
BACKEND_ENABLED=false
DELIVERY_DEDUP_ENABLED=true
DELIVERY_STATE_PATH=runtime/openvas/delivery.sqlite3
DELIVERY_BATCH_SIZE=200
DELIVERY_RETRY_SECONDS=60
DELIVERY_RETRY_MAX_SECONDS=3600
DELIVERY_ACK_RETENTION_DAYS=90
BACKEND_URL=https://10.208.232.208/txdxsecure/guarda_alarma.php
BACKEND_LOCAL=Txdxsecure
BACKEND_ALARM_TYPE=Alarma de seguridad de OpenVAS x TXDXSecure
BACKEND_TLS_VERIFY=true
BACKEND_TIMEOUT=30
PERSIST_PAYLOAD_ARTIFACTS=true
PERSIST_RAW_API_DEBUG=false
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1
LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1
